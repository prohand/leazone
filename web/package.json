{
  "name": "leazone-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "postbuild": "node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "gen:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable false -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.577.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
