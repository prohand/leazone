# Leazone - docker compose settings. Copy to compose/.env and edit.
# Secrets are NOT set here: they are files in compose/secrets/ (Docker secrets).

# Image to run (published by GitHub Actions).
LEAZONE_IMAGE=ghcr.io/prohand/leazone:latest

# URL typed in the browser. Behind nginx: the nginx name, e.g.
#   https://leazone.mondomaine.lan
# Passkeys need a domain name (no IP) and a trusted certificate.
LEAZONE_PUBLIC_URL=

# IPs (or networks) of the reverse proxies allowed to send X-Forwarded-For.
# Example with nginx on the same host: 127.0.0.1
LEAZONE_TRUSTED_PROXIES=

# Address of the web interface / API (HTTPS). 8443 by default.
LEAZONE_HTTP_LISTEN=:8443

# User running Leazone inside the container. If you change it, give the
# volumes to this user: docker run --rm -v leazone_leazone-data:/d alpine chown -R UID:GID /d
LEAZONE_UID=1000
LEAZONE_GID=1000

# Name of the first admin account (created on first start only).
LEAZONE_ADMIN_USER=admin

# debug | info | warn | error
LEAZONE_LOG_LEVEL=info

TZ=Europe/Paris
