# Leazone HA - same file on node 1 and node 2. Copy to compose/.env and edit.
# Secrets are files in compose/secrets/ (admin_password, cluster_key).

LEAZONE_IMAGE=ghcr.io/prohand/leazone:latest

# Addresses of the two nodes (cluster traffic on TCP 7443, mutual TLS).
NODE1_NAME=dns1
NODE1_IP=192.168.1.2
NODE2_NAME=dns2
NODE2_IP=192.168.1.3

# Witness: the container on a 3rd host (recommended)...
LEAZONE_WITNESS=https://192.168.1.4:7443
# ...or an IP to ping (partial protection against split brain), e.g.:
# LEAZONE_WITNESS=ping:192.168.1.1

# Virtual IP held by the primary (optional). Give it to clients as DNS
# server, point nginx to it, and use its name for passkeys.
LEAZONE_VIP=192.168.1.10/24
NODE1_VIP_INTERFACE=eno1
NODE2_VIP_INTERFACE=eno1

# Same public URL on both nodes (the VIP name): passkeys keep working after a failover.
LEAZONE_PUBLIC_URL=https://leazone.mondomaine.lan
LEAZONE_TRUSTED_PROXIES=

LEAZONE_HTTP_LISTEN=:8443
LEAZONE_UID=1000
LEAZONE_GID=1000
LEAZONE_ADMIN_USER=admin
LEAZONE_LOG_LEVEL=info
TZ=Europe/Paris
